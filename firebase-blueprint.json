{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "1:1 파트너십 대화 신청 내역",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "신청자 성함"
        },
        "contact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "신청자 연락처"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "format": "email",
          "description": "신청자 이메일 주소"
        },
        "programId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "선택한 관심 프로그램 ID 목록 (쉼표 구분 또는 none)"
        },
        "programTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "선택한 관심 프로그램 명칭 요약"
        },
        "dilemma": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "description": "함께 이야기 나누고 싶은 주제 또는 고민"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "contacted", "confirmed", "cancelled"],
          "description": "상담 진행 상태"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "신청 접수 일시 (서버 타임스탬프)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "상태 최종 변경 일시 (서버 타임스탬프)"
        }
      },
      "required": [
        "name",
        "contact",
        "email",
        "programId",
        "programTitle",
        "dilemma",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "1:1 파트너십 대화 신청 문서 컬렉션 (일반 방문자는 생성만 가능, 조회/수정/삭제는 관리자 계정만 허용)"
    }
  }
}
