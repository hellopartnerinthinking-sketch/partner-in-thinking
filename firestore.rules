rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict Admin Gate: ONLY verified Google account hello.partnerinthinking@gmail.com
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'hello.partnerinthinking@gmail.com';
    }

    // Booking schema validation helper (matches firebase-blueprint.json constraints)
    function isValidBooking(data) {
      return data.keys().hasAll([
          'name',
          'contact',
          'email',
          'programId',
          'programTitle',
          'dilemma',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'name',
          'contact',
          'email',
          'programId',
          'programTitle',
          'dilemma',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.contact is string && data.contact.size() >= 1 && data.contact.size() <= 40
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.programId is string && data.programId.size() >= 1 && data.programId.size() <= 120
        && data.programTitle is string && data.programTitle.size() >= 1 && data.programTitle.size() <= 200
        && data.dilemma is string && data.dilemma.size() >= 1 && data.dilemma.size() <= 3000
        && data.status is string && data.status in ['pending', 'contacted', 'confirmed', 'cancelled']
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Bookings Collection:
    // - Public visitors can submit (create) a validated pending booking without reading anyone else's data.
    // - ONLY verified Admin (hello.partnerinthinking@gmail.com) can get, list, update status, or delete bookings.
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(bookingId)
        && isValidBooking(incoming())
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);

      allow update: if isValidId(bookingId)
        && isAdmin()
        && isValidBooking(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && incoming().name == existing().name
        && incoming().contact == existing().contact
        && incoming().email == existing().email
        && incoming().programId == existing().programId
        && incoming().programTitle == existing().programTitle
        && incoming().dilemma == existing().dilemma
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(bookingId) && isAdmin();
    }
  }
}
